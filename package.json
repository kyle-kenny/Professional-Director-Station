{
  "name": "professional-director-station",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "characters:install": "node scripts/install-character-assets.mjs",
    "predev": "npm run characters:install",
    "dev": "vite",
    "prebuild": "npm run characters:install",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "node scripts/visual-smoke-runner.mjs && node scripts/director-console-e2e.mjs",
    "audit:static": "node scripts/quality-gate.mjs",
    "audit:windows": "node scripts/windows-smoke.mjs",
    "audit:collab": "node scripts/collaboration-smoke.mjs && node scripts/collaboration-server-smoke.mjs",
    "audit:pipeline": "node scripts/pipeline-smoke.mjs",
    "audit:ai": "node scripts/ai-smoke.mjs",
    "audit:characters": "node scripts/character-rig-smoke.mjs",
    "audit:localization": "node scripts/localization-smoke.mjs",
    "audit:director": "node scripts/director-console-smoke.mjs",
    "audit:deps": "npm audit --audit-level=high --omit=dev",
    "check": "npm run characters:install && npm run audit:static && npm run audit:windows && npm run audit:collab && npm run audit:pipeline && npm run audit:ai && npm run audit:characters && npm run audit:localization && npm run audit:director && npm run test && npm run build",
    "collab:server": "node server/collab-server.mjs",
    "collab:token": "node scripts/issue-collab-token.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "mediabunny": "^1.54.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.18.0",
    "yjs": "^13.6.32",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "1.63.0",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
